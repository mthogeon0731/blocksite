# 편집기·쓰기 API 보호 키. 비워 두면 검사하지 않음(로컬 개발).
# 배포할 때는 꼭 설정하고 편집기를 /editor/site_kimlab?key=값 으로 연다 (쿠키 30일).
EDITOR_KEY=

# Supabase. 아래 두 값이 모두 있으면 Supabase(Postgres + Storage 버킷 photos)를 쓰고,
# 없으면 로컬 저장소(.data/db.json, .data/uploads/)를 쓴다. 배포(Vercel)에는 필수.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 지금은 서버 라우트만 DB를 쓰므로 anon 키는 쓰지 않는다 (SPEC 8절에 있어 자리만 둠)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
